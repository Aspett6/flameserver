# ===== DeepSeek API 配置 =====
# 复制本文件为 .env，并填入你的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# DeepSeek 接口地址（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型 ID：项目需求为 DeepSeek-V4-Flash（开启思考模式）。
# 请以 DeepSeek 官方文档为准填写实际可用的模型 ID；
# 若使用官方推理模型思考模式，可改为 deepseek-reasoner。
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 视觉识别（阿里云百炼 / 通义千问 Qwen-VL）配置 =====
# 用于「AI 隐患识别」随手拍功能，未配置则该功能返回友好报错
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# DashScope OpenAI 兼容接口地址（一般无需修改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 视觉模型 ID（Qwen2.5-VL 系列，可换 qwen-vl-max 等）
VISION_MODEL=qwen-vl-plus

# ===== 服务配置 =====
PORT=3001

# 允许跨域访问的前端来源（本地开发 * 即可；生产填 Netlify 地址）
CLIENT_ORIGIN=*
